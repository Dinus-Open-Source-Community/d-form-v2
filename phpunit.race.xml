<?xml version="1.0" encoding="UTF-8"?>
<!--
    Opt-in suite for tests that need a real MySQL engine (row locks, EXPLAIN plans).

    Prepare a disposable database first (see docs/adr/0001, section "How to run the MySQL
    concurrency and plan suite"), then run phpunit with this configuration and a filter.

    The database name must match `*_test`, `*_testing`, or `*_e2e`; the tests skip themselves
    for any other name so they can never touch a shared database.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <server name="APP_ENV" value="testing"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <server name="CACHE_STORE" value="array"/>
        <server name="DB_CONNECTION" value="mysql"/>
        <server name="DB_HOST" value="db"/>
        <server name="DB_PORT" value="3306"/>
        <server name="DB_DATABASE" value="d_form_test"/>
        <server name="DB_USERNAME" value="root"/>
        <server name="DB_PASSWORD" value="secret"/>
        <server name="RUN_MYSQL_RACE_TESTS" value="1"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="TRUSTED_PROXIES" value=""/>
        <server name="TRUSTED_HOSTS" value=""/>
        <server name="PULSE_ENABLED" value="false"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
