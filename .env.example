APP_NAME="DForm"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta

LOG_LEVEL=debug

DB_CONNECTION=mysql
